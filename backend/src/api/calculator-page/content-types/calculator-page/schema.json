{
  "kind": "singleType",
  "collectionName": "calculator_pages",
  "info": {
    "singularName": "calculator-page",
    "pluralName": "calculator-pages",
    "displayName": "Calculator page",
    "description": "Content and settings for the gardening calculator section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "intro": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaults": {
      "type": "component",
      "component": "calc.defaults",
      "repeatable": false
    },
    "faq": {
      "type": "component",
      "component": "calc.faq-item",
      "repeatable": true
    },
    "showCalculator": {
      "type": "boolean",
      "default": true
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    }
  }
